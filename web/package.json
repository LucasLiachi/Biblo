{
  "name": "biblo-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "ds:sync": "node ../scripts/design-system/sync.mjs",
    "ds:check": "node ../scripts/design-system/check.mjs",
    "verify": "npm run ds:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/inter": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.0",
    "@lezer/highlight": "1.2.4",
    "dompurify": "3.4.16",
    "lucide-react": "0.475.0",
    "markdown-it": "14.3.2",
    "mermaid": "11.17.2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "26.1.0",
    "typescript": "5.7.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
