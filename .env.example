# Biblo — copie para .env e preencha. O .env nunca vai para o Git.

BIBLO_ENV=dev                      # dev habilita /api/docs
BIBLO_UID=1000                     # dono dos arquivos do vault no host (id -u)
BIBLO_GID=1000                     # (id -g)

# Banco do índice (descartável: é reconstruído a partir de ./vault)
DB_USER=biblo
DB_PASSWORD=                       # obrigatório; gere com: openssl rand -base64 24
DB_NAME=biblo

# Chat: gateway OpenAI-compatível.
# AILab: http://ailab_litellm:4000/v1 (chave virtual do LiteLLM)
# Ollama local: http://host.docker.internal:11434/v1 (chave vazia)
LLM_BASE_URL=http://ailab_litellm:4000/v1
LLM_API_KEY=

# Embeddings: ollama | openai (LiteLLM /v1/embeddings) | none (só busca textual)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768                  # o schema usa vector(768)

# Limites
MAX_UPLOAD_MB=15
MAX_DOCUMENT_MB=5
MAX_CHUNKS_PER_DOC=100
RAG_MAX_CONTEXT_TOKENS=4000
WATCHER_MODE=auto                  # auto | inotify | polling (WSL2 em /mnt/c)
